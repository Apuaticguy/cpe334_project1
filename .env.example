# ==============================================================================
# QuickOrder - Environment Configuration Template (.env.example)
# Never commit real credentials or .env files to version control!
# ==============================================================================

# Server Runtime
PORT=5001
NODE_ENV=development
TZ=Asia/Bangkok

# Database Connection (PostgreSQL)
# Local Docker / development fallback:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickorder_db?schema=public"

# Authentication Security
# Minimum 32 characters for JWT signing
JWT_SECRET="quickorder_development_jwt_secret_key_change_in_production_min_32_chars"

# Database Seeding (Production demo accounts)
# Default password for seeded Customer & Operator demo users
DEMO_USER_PASSWORD="Password123!"

# Client Runtime (Vite SPA)
# Leave empty in unified production container to call relative /api on same origin
VITE_API_URL="http://localhost:5001/api"
